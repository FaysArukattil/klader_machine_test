<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ (API 31+) splash screen using the SplashScreen API.
     Whitish background matching the login screen. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <!-- Background color matching the whitish login screen -->
        <item name="android:windowSplashScreenBackground">#F5F6FA</item>
        <!-- Transparent icon so Android 12+ does not display any cropped icon in the middle -->
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <!-- Keep the splash until Flutter draws its first frame -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>
