<?xml version="1.0" encoding="utf-8"?>
<!-- Klader splash screen (API 21+) — whitish background matching login screen with dark-shade Klader logo PNG -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="#F5F6FA" />
    </item>
    <item
        android:left="40dp"
        android:right="40dp">
        <bitmap
            android:gravity="center"
            android:src="@drawable/klader_logo"/>
    </item>
</layer-list>
